# CONFIGURAÇÕES DO SERVIDOR
NODE_ENV=development
PORT=3000

# INTEGRAÇÃO STRIPE
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID=prod_...

# INTEGRAÇÃO SUPABASE POSTGRESQL & AUTH
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-auth-secret

# CREDENCIAL MASTER DO PAINEL SAAS
# Definida por variável de ambiente. NUNCA commitar o valor real.
SAAS_MASTER_EMAIL=fabiano@helpit.com.br
SAAS_MASTER_PASSWORD=change-me-in-production

# INTEGRAÇÃO ASAAS (PIX QR Code)
# Obtenha sua API Key em: https://www.asaas.com/config/integracoes
ASAAS_API_KEY=$aact_...
# Token para validar webhooks (opcional, mas recomendado)
ASAAS_WEBHOOK_TOKEN=whsec_...
# Defina como "true" para usar o ambiente sandbox do Asaas
ASAAS_SANDBOX=true
