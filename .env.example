# CONFIGURAÇÕES DO SERVIDOR
NODE_ENV=development
PORT=3000

# INTEGRAÇÃO STRIPE
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRODUCT_ID=prod_...

# INTEGRAÇÃO SUPABASE POSTGRESQL & AUTH
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-auth-secret

# CREDENCIAL MASTER DO PAINEL SAAS
# Definida por variável de ambiente. NUNCA commitar o valor real.
SAAS_MASTER_PASSWORD=change-me-in-production
VITE_SAAS_MASTER_PASSWORD=change-me-in-production
